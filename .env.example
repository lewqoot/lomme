NODE_ENV=development
PORT=3000
APP_NAME=Lomme
APP_URL=http://127.0.0.1:4173
LEGACY_PREVIEW_URL=http://127.0.0.1:4599
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/lomme
SESSION_SECRET=replace-with-at-least-32-random-characters
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
VITE_TELEGRAM_BOT_USERNAME=
VITE_SUPPORT_URL=
# Telegram reuses an existing iOS Mini App WebView after a short close/reopen.
# Only correctly signed initData is accepted; set a shorter value if required.
TELEGRAM_INIT_MAX_AGE_SECONDS=2592000
ALLOW_DEV_AUTH=false
VITE_APP_NAME=Lomme
VITE_ACCENT_COLOR=#32d583
# Public Apple iCloud link created by Shortcuts, never a .shortcut file URL.
VITE_SHORTCUT_ICLOUD_URL=
