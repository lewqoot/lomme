{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "sourceMap": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["server/**/*.ts", "src/shared/**/*.ts", "tests/**/*.ts"]
}
