{
  "name": "lomme",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.17.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,cyan \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "ALLOW_DEV_AUTH=true tsx watch server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "tsc -b tsconfig.app.json && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "worker": "node dist-server/server/worker.js",
    "announce": "tsx scripts/announce.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc -b tsconfig.app.json && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "oxlint src server tests",
    "preview": "vite preview",
    "build:design": "vite build --config vite.design.config.ts",
    "deploy:design": "npm run build:design && railway up ./dist-design --path-as-root --service design-preview --environment production --detach -m \"Design preview\""
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@tanstack/react-query": "^5.102.3",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "lucide-react": "^1.34.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.79.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "browserslist": [
    "chrome >= 111",
    "safari >= 15.4",
    "firefox >= 121",
    "ios_saf >= 15.4"
  ]
}
